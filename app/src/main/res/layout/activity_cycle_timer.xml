<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnBackTimer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:background="@drawable/bg_button_secondary" />

        <TextView
            android:id="@+id/tvTimerMachineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WASHER-01 Active"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="44dp" />
    </LinearLayout>

    <!-- Animated Washer Drum Visual -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginVertical="16dp">

        <View
            android:id="@+id/viewDrumOuter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_drum" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="34:58"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrumPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Washing Cycle"
                android:textColor="@color/accent_glow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Phase Stepper Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current Stage"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStagePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 2 of 4 (45%)"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbCycleProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="45"
            android:progressTint="@color/accent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCycleDetailSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agitating drum with detergent solution • 1000 RPM"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Real-time Telemetry Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTelemetryTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40°C"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water Temp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTelemetryRpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1000 RPM"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motor Speed"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCKED"
                android:textColor="@color/success"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Door Lock"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPauseResume"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Pause Cycle"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEmergencyStop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Emergency Stop"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
